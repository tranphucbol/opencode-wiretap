{
  "name": "wiretap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun run --filter @wiretap/server dev",
    "dev:web": "bun run --filter @wiretap/web dev",
    "server": "bun run --filter @wiretap/server start",
    "build": "bun run --filter '*' build",
    "typecheck": "tsc -p tsconfig.json --noEmit && bun run --filter '*' typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run typecheck",
    "clean": "bun run --filter '*' clean"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.7.2"
  }
}
