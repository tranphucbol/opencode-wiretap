{
  "name": "@wiretap/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "echo 'server runs from TypeScript source under Bun, nothing to build'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf *.tsbuildinfo"
  },
  "dependencies": {
    "@wiretap/shared": "workspace:*",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.0"
  }
}
