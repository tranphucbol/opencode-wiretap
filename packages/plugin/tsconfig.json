{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    // Bun only, not node alongside it: @types/bun already pulls @types/node in,
    // and listing both makes DOM-ish globals (`Response`) resolve to two
    // incompatible declarations. The plugin runs inside OpenCode, on Bun.
    "types": ["bun"]
  },
  "include": ["src", "scripts"],
  "exclude": ["node_modules", "dist"]
}
