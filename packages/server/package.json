{
  "name": "opencode-wiretap-viewer",
  "version": "0.1.0",
  "type": "module",
  "description": "Local viewer for OpenCode wiretap captures — serves the web UI and its API from one process",
  "license": "MIT",
  "author": "tranphucbol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tranphucbol/opencode-wiretap.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/tranphucbol/opencode-wiretap#readme",
  "bugs": "https://github.com/tranphucbol/opencode-wiretap/issues",
  "keywords": [
    "opencode",
    "wiretap",
    "llm",
    "debugging",
    "viewer"
  ],
  "bin": {
    "opencode-wiretap-viewer": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.0",
    "@wiretap/shared": "workspace:*"
  }
}
